# ==============================================================================
# GUFTAGU — Local Development Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root to override default settings:
#   cp .env.example .env
#
# IMPORTANT:
# - These values are pre-configured for local developer environments only.
# - Never commit real credentials, production secrets, or private keys.
# ==============================================================================

# Local PostgreSQL Docker Container Configuration
GUFTAGU_POSTGRES_PORT=5432
GUFTAGU_POSTGRES_DB=guftagu_dev
GUFTAGU_POSTGRES_USER=guftagu_user
GUFTAGU_POSTGRES_PASSWORD=guftagu_dev_password

# Spring Boot Datasource Connection (mirrors the container configuration above)
GUFTAGU_DATABASE_URL=jdbc:postgresql://localhost:5432/guftagu_dev
GUFTAGU_DATABASE_USERNAME=guftagu_user
GUFTAGU_DATABASE_PASSWORD=guftagu_dev_password
